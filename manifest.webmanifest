{
  "name": "Caderno",
  "short_name": "Caderno",
  "description": "Rotina, leitura com destaques, aulas transcritas e revisão espaçada.",
  "lang": "pt-BR",
  "start_url": "./#hoje",
  "scope": "./",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    { "action": "./#ler", "accept": { "application/epub+zip": [".epub"], "application/pdf": [".pdf"], "text/plain": [".txt"] } }
  ]
}
